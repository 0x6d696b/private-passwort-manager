# Anonymized example hostname: replace for your private DNS before enrollment.
# Staging defaults: HTTPS is reachable only from the Pi itself.
# Choose the permanent hostname before enrolling any authenticator.
VAULT_HOST=vault.home.arpa
VAULT_LAN_IP=127.0.0.1
VAULT_API_IMAGE=private-vault-api:pi-staging
VAULT_PROXY_IMAGE=private-vault-proxy:pi-staging
# Base-image digests from the validated ARM64 container builds.
# These are reproducibility pins, not evidence of an image vulnerability scan.
RUST_IMAGE=rust@sha256:ade39a710ef85f3506cffcfec3e8a24ba090badef1dff2fb798f71d878833fea
RUNTIME_IMAGE=debian@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc
CADDY_IMAGE=caddy@sha256:4851e54a46b206517c574821bb5cc67f170d2156041e9fbc4c9193b45e84a75b
