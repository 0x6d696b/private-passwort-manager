{
    admin off
    auto_https disable_redirects
    https_port 8443
    servers {
        protocols h1 h2
        max_header_size 16KB
        timeouts {
            read_header 5s
            read_body 10s
            write 30s
            idle 60s
        }
    }
}

https://{$VAULT_HOST} {
    tls internal
    request_body {
        max_size 256KB
    }
    @backend path /api/* /health
    handle @backend {
        reverse_proxy api:8080 {
            header_up -X-Forwarded-For
            header_up -X-Forwarded-Host
            header_up -X-Forwarded-Proto
            transport http {
                dial_timeout 3s
                response_header_timeout 12s
            }
        }
    }
    handle {
        root * /srv/client
        header {
            Cache-Control "no-store"
            X-Content-Type-Options "nosniff"
            Referrer-Policy "no-referrer"
            Content-Security-Policy "default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; style-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
            Permissions-Policy "camera=(), microphone=(), geolocation=()"
        }
        file_server
    }
    header Strict-Transport-Security "max-age=31536000"
}
